# Neon bağlantı adresi (Neon paneli > Connect > pooled connection)
DATABASE_URL=postgresql://kullanici:sifre@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Sipariş butonlarının WhatsApp numarası (ülke koduyla, örn. 905xxxxxxxxx)
WHATSAPP_NUMBER=
# Admin paneli giriş bilgileri (canlıda ADMIN_PASSWORD zorunlu; kullanıcı adı boşsa "admin")
ADMIN_USER=admin
# Önerilen: şifrenin özeti (scripts/hash-password.ps1 üretir, biçim tuz:özet). Doluysa ADMIN_PASSWORD yok sayılır.
ADMIN_PASSWORD_HASH=
# Ya da düz şifre (özet kullanmıyorsanız):
ADMIN_PASSWORD=degistirin
# İsteğe bağlı: oturum imzası için gizli anahtar (boşsa DATABASE_URL'den türetilir)
SESSION_SECRET=
